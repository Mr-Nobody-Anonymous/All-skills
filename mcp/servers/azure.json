{
  "id": "azure",
  "name": "Azure",
  "description": "Azure resource management, diagnostics and service tooling through the official Azure MCP server.",
  "category": "cloud",
  "tier": "full",
  "transport": "stdio",
  "vendor": "microsoft",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@azure/mcp",
    "server",
    "start"
  ],
  "required_env": [],
