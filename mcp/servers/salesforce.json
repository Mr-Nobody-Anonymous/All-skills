{
  "id": "salesforce",
  "name": "Salesforce",
  "description": "Query and update Salesforce objects with SOQL.",
  "category": "crm",
  "tier": "full",
  "transport": "stdio",
  "vendor": "salesforce",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "@salesforce/mcp"
  ],
  "required_env": [
    "SALESFORCE_INSTANCE_URL",
    "SALESFORCE_ACCESS_TOKEN"
  ],
  "risk": "high",
  "license": "Apache-2.0",
  "docs": "https://github.com/forcedotcom/mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
