{
  "id": "confluence",
  "name": "Confluence",
  "description": "Search and update Confluence spaces and pages.",
  "category": "knowledge",
  "tier": "full",
  "transport": "stdio",
  "vendor": "atlassian",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "mcp-confluence"
  ],
  "required_env": [
    "CONFLUENCE_URL",
    "CONFLUENCE_TOKEN"
  ],
  "risk": "medium",
  "license": "MIT",
  "docs": "https://github.com/aaronsb/confluence-cloud-mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
