{
  "id": "browserbase",
  "name": "Browserbase",
  "description": "Remote headless browser sessions with stealth and session replay.",
  "category": "browser",
  "tier": "full",
  "transport": "stdio",
  "vendor": "browserbase",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@browserbasehq/mcp"
  ],
  "required_env": [
    "BROWSERBASE_API_KEY",
    "BROWSERBASE_PROJECT_ID"
  ],
  "risk": "medium",
  "license": "Apache-2.0",
  "docs": "https://github.com/browserbase/mcp-server-browserbase",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
