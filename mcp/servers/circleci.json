{
  "id": "circleci",
  "name": "CircleCI",
  "description": "Pipeline health, failed job logs and build configuration for CircleCI projects.",
  "category": "ci-cd",
  "tier": "full",
  "transport": "stdio",
  "vendor": "circleci",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@circleci/mcp-server-circleci@latest"
  ],
  "required_env": [
    "CIRCLECI_TOKEN"
  ],
  "risk": "medium",
  "license": "Apache-2.0",
  "docs": "https://github.com/CircleCI-Public/mcp-server-circleci",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
