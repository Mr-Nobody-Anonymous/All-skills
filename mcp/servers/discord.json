{
  "id": "discord",
  "name": "Discord",
  "description": "Read channels and messages and post to Discord servers.",
  "category": "communication",
  "tier": "full",
  "transport": "stdio",
  "vendor": "community",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "discord-mcp"
  ],
  "required_env": [
    "DISCORD_BOT_TOKEN"
  ],
  "risk": "medium",
  "license": "MIT",
  "docs": "https://github.com/SaseQ/discord-mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
