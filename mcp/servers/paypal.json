{
  "id": "paypal",
  "name": "PayPal",
  "description": "PayPal orders, payments, invoices and disputes for sandbox or live accounts.",
  "category": "payments",
  "tier": "full",
  "transport": "stdio",
  "vendor": "paypal",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@paypal/mcp@latest"
  ],
  "required_env": [
    "PAYPAL_ACCESS_TOKEN",
    "PAYPAL_ENVIRONMENT"
  ],
  "risk": "high",
  "license": "Apache-2.0",
  "docs": "https://github.com/paypal/paypal-mcp-server",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
