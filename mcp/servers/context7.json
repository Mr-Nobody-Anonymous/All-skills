{
  "id": "context7",
  "name": "Context7",
  "description": "Up-to-date, version-pinned library documentation and code examples.",
  "category": "documentation",
  "tier": "standard",
  "transport": "stdio",
  "vendor": "upstash",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "@upstash/context7-mcp"
  ],
  "required_env": [
    "CONTEXT7_API_KEY"
  ],
  "risk": "low",
  "license": "MIT",
  "docs": "https://github.com/upstash/context7",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
