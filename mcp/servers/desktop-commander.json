{
  "id": "desktop-commander",
  "name": "Desktop Commander",
  "description": "Terminal control and file editing with configurable safety bounds.",
  "category": "execution",
  "tier": "full",
  "transport": "stdio",
  "vendor": "community",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "@wonderwhy-er/desktop-commander@latest"
  ],
  "required_env": [],
  "risk": "high",
  "license": "MIT",
  "docs": "https://github.com/wonderwhy-er/DesktopCommanderMCP",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
