{
  "id": "remote-fs",
  "name": "SSH Remote Filesystem",
  "description": "Browse and edit files on a remote host over SSH.",
  "category": "files",
  "tier": "full",
  "transport": "stdio",
  "vendor": "community",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "mcp-ssh-manager"
  ],
  "required_env": [
    "SSH_HOST",
    "SSH_USER",
    "SSH_KEY_PATH"
  ],
  "risk": "high",
  "license": "MIT",
  "docs": "https://github.com/bvisible/mcp-ssh-manager",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
