  "category": "media",
  "tier": "full",
  "transport": "stdio",
  "vendor": "community",
  "official": false,
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-spotify"
  ],
  "required_env": [
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET"
  ],
  "risk": "low",
  "license": "MIT",
  "docs": "https://github.com/modelcontextprotocol/servers-archived",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
