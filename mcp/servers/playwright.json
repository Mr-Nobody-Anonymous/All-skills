{
  "id": "playwright",
  "name": "Playwright",
  "description": "Drive a real browser through accessibility snapshots for end-to-end testing and scraping.",
  "category": "browser",
  "tier": "standard",
  "transport": "stdio",
  "vendor": "microsoft",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@playwright/mcp@latest"
  ],
  "required_env": [],
  "risk": "medium",
  "license": "Apache-2.0",
  "docs": "https://github.com/microsoft/playwright-mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
