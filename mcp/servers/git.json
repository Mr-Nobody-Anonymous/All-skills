{
  "id": "git",
  "name": "Git",
  "description": "Inspect status, diffs, logs and history of a local git repository without mutating it.",
  "category": "source-control",
  "tier": "core",
  "transport": "stdio",
  "vendor": "modelcontextprotocol",
  "official": true,
  "command": "uvx",
  "args": [
    "mcp-server-git",
    "--repository",
    "${WORKSPACE}"
  ],
  "required_env": [],
  "risk": "low",
  "license": "MIT",
  "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
