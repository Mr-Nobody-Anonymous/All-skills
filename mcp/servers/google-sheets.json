{
  "id": "google-sheets",
  "name": "Google Sheets",
  "description": "Read and write Google Sheets cells, sheets and Drive metadata.",
  "category": "productivity",
  "tier": "full",
  "transport": "stdio",
  "vendor": "xing5",
  "official": false,
  "command": "uvx",
  "args": [
    "mcp-google-sheets"
  ],
  "required_env": [
    "GOOGLE_APPLICATION_CREDENTIALS"
  ],
  "risk": "medium",
  "license": "MIT",
  "docs": "https://github.com/xing5/mcp-google-sheets",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
