{
  "id": "mysql",
  "name": "MySQL",
  "description": "Inspect schemas and run read-only SQL against MySQL or MariaDB with an explicit use-case allowlist.",
  "category": "database",
  "tier": "standard",
  "transport": "stdio",
  "vendor": "designcomputer",
  "official": false,
  "command": "uvx",
  "args": [
    "mysql-mcp-server"
  ],
  "required_env": [
    "MYSQL_HOST",
    "MYSQL_USER",
    "MYSQL_PASSWORD",
    "MYSQL_DATABASE"
  ],
  "risk": "medium",
  "license": "MIT",
  "docs": "https://github.com/designcomputer/mysql_mcp_server",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
