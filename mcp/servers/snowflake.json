{
  "id": "snowflake",
  "name": "Snowflake",
  "description": "Read-only SQL against Snowflake with warehouse, role and schema awareness; writes stay opt-in.",
  "category": "database",
  "tier": "full",
  "transport": "stdio",
  "vendor": "isaacwasserman",
  "official": false,
  "command": "uvx",
  "args": [
    "mcp-server-snowflake"
  ],
  "required_env": [
    "SNOWFLAKE_ACCOUNT",
    "SNOWFLAKE_USER",
    "SNOWFLAKE_PASSWORD",
    "SNOWFLAKE_WAREHOUSE",
    "SNOWFLAKE_DATABASE"
  ],
  "risk": "high",
  "license": "MIT",
  "docs": "https://github.com/isaacwasserman/mcp-snowflake-server",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
