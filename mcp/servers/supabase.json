{
  "id": "supabase",
  "name": "Supabase",
  "description": "Manage Supabase projects, tables, edge functions and migrations.",
  "category": "database",
  "tier": "full",
  "transport": "stdio",
  "vendor": "supabase",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@supabase/mcp-server-supabase@latest",
    "--access-token",
    "${SUPABASE_ACCESS_TOKEN}"
  ],
  "required_env": [
    "SUPABASE_ACCESS_TOKEN"
  ],
  "risk": "high",
  "license": "Apache-2.0",
  "docs": "https://github.com/supabase-community/supabase-mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
