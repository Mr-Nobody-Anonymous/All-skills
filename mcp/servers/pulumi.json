{
  "id": "pulumi",
  "name": "Pulumi",
  "description": "Inspect stacks, preview and apply infrastructure changes, and query Pulumi Cloud.",
  "category": "infrastructure",
  "tier": "full",
  "transport": "stdio",
  "vendor": "pulumi",
  "official": true,
  "command": "npx",
  "args": [
    "-y",
    "@pulumi/mcp-server@latest"
  ],
  "required_env": [
    "PULUMI_ACCESS_TOKEN"
  ],
  "risk": "high",
  "license": "Apache-2.0",
  "docs": "https://www.pulumi.com/docs/iac/using-pulumi/mcp-server/",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
