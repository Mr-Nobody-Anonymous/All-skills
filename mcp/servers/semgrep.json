{
  "id": "semgrep",
  "name": "Semgrep",
  "description": "Static analysis and security rule scanning for source trees.",
  "category": "security",
  "tier": "full",
  "transport": "stdio",
  "vendor": "semgrep",
  "official": true,
  "command": "uvx",
  "args": [
    "semgrep-mcp"
  ],
  "required_env": [],
  "risk": "low",
  "license": "LGPL-2.1",
  "docs": "https://github.com/semgrep/semgrep-mcp",
  "harnesses": [
    "claude",
    "cursor",
    "codex",
    "vscode",
    "gemini",
    "windsurf",
    "cline",
    "roo",
    "goose",
    "opencode",
    "zed",
    "qwen",
    "kimi",
    "hermes",
    "openclaw",
    "trae",
    "codebuddy",
    "continue"
  ],
  "policy": {
    "policy": "least-privilege",
    "read_only_default": true,
    "require_approval_for_destructive": true
  }
}
