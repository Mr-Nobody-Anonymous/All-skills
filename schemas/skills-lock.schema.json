{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillsLockfile",
  "description": "Deterministic, cryptographically pinned lockfile for agent skill environments.",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of when the lockfile was generated."
    },
    "generator": {
      "type": "string",
      "description": "Tool that generated the lockfile."
    },
    "total_skills": {
      "type": "integer",
      "description": "Number of locked skill dependencies."
    },
    "skills": {
      "type": "object",
      "description": "Map of skill identifier to locked metadata and cryptographic hash.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "sha256"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Semantic version of the skill."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 tree hash of the skill directory contents."
          },
          "category": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_at": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": ["safe", "low", "medium", "high", "critical"]
          }
        }
      }
    }
  }
}
