{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentToolSchema",
  "type": "object",
  "required": [
    "tool_id",
    "version",
    "capabilities",
    "risk_level"
  ],
  "properties": {
    "tool_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}