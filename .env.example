# ==============================================================================
# All-Skills — environment variables (template)
#
#   cp .env.example .env        # .env is git-ignored — never commit real values
#
# The core platform (CLI, router, runtime, validation, tests) needs NONE of these.
# They are optional credentials for skills and integrations that call external
# services. The execution runtime brokers to a skill ONLY the secrets it declares
# in its manifest (see `broker_secrets` in src/skills/policy.py), so unrelated
# skills never see these values.
# ==============================================================================

# ──── AI model providers ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# ──── Knowledge & search ──────────────────────────────────────────────────────
WOLFRAM_APP_ID=
SEARXNG_BASE_URL=http://localhost:8080
NEWS_API_KEY=

# ──── Communication ───────────────────────────────────────────────────────────
GMAIL_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SLACK_BOT_TOKEN=

# ──── Media & entertainment ───────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ──── Cloud & infrastructure ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ──── Finance ─────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ──── Smart home ──────────────────────────────────────────────────────────────
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
