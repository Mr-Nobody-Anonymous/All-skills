{
  "name": "@mr-nobody-anonymous/all-skills",
  "version": "3.0.0",
  "description": "Universal Agent Skill Operating System and Multi-Agent Harness for Claude Code, Cursor, Codex, OpenClaw, SkillHub, and Antigravity",
  "author": "Mr-Nobody-Anonymous",
  "license": "MIT",
  "homepage": "https://github.com/Mr-Nobody-Anonymous/All-skills#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Nobody-Anonymous/All-skills.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-Nobody-Anonymous/All-skills/issues"
  },
  "keywords": [
    "ai-agent",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "openclaw",
    "skillhub",
    "model-context-protocol",
    "mcp",
    "prompt-engineering",
    "developer-tools"
  ],
  "bin": {
    "allskills": "./bin/allskills.js"
  },
  "scripts": {
    "test": "python scripts/skills/skills.py test",
    "validate": "python scripts/validate_schema.py && python scripts/validate_skillhub_spec.py",
    "verify:registry": "python scripts/verify_registry_integrity.py",
    "doctor": "python scripts/allskills.py doctor --full",
    "evals": "python scripts/run_evals.py",
    "security": "python scripts/scan_skills_security.py",
    "setup": "python scripts/setup_skills.py",
    "baseline": "python scripts/generate_baselines.py",
    "baseline:verify": "python scripts/generate_baselines.py --verify",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.10.0"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "skills/",
    ".agents/skills/",
    "registry/",
    "profiles/",
    "schemas/",
    "adapters/",
    "platforms/",
    "policies/",
    "evals/",
    "workflows/",
    "packs/",
    "sources/",
    "hooks/",
    "state/",
    "config.yaml",
    "manifest.json",
    "mcp_config.json",
    "skills.lock",
    "stats.json",
    "dependency_graph.json",
    "pyproject.toml",
    "setup.py",
    "requirements.txt",
    "requirements-core.txt",
    "VERSION",
    "README.md",
    "LICENSE"
  ]
}
