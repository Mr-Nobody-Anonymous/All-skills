# ==============================================================================
# All-Skills — .gitignore
#
# IMPORTANT: this repository contains ~15k skill directories with generic names
# (e.g. `awesome_skills/automation/build/`). Build/output patterns below are
# therefore ANCHORED to the repository root with a leading `/` so they never
# silently exclude skill content. An unanchored `build/` rule previously kept
# the `automation/build` skill out of Git and broke the catalog statistics.
# Check a pattern before adding it:  git check-ignore -v <path>
# ==============================================================================

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
/build/
/dist/
/wheels/

# Test, coverage & type-checker caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
/env/
/ENV/

# ─── Node / JavaScript ────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache

# ─── Other toolchains (root-level build outputs only) ─────────────────────────
/target/
/vendor/
*.exe
*.out
*.o
*.obj

# ─── Secrets & environment variables ──────────────────────────────────────────
# Never commit real credentials. Copy `.env.example` to `.env` instead.
.env
.env.*
!.env.example
!.env.sample
!.env.template
# Real credentials created from config/api_keys.yml.template (docs/configuration.md)
config/api_keys.yml
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*

# ─── Generated runtime views (hub-and-spoke architecture) ─────────────────────
# These agent harness directories are intentionally ignored because they are
# runtime materialisations generated by scripts/setup_tools.py via junctions or
# symlinks. The canonical content lives in .agents/skills/ (the source harness)
# and skills/ (the curated skill library). Adding them to git would duplicate
# every skill file for each of the 11 supported agents.
# To regenerate: python scripts/setup_tools.py
# To see link status: python scripts/setup_tools.py --status
.vscode/
.idea/
.claude/
.cursor/
.codex/
.cline/
.goose/
.opencode/
.roo/
.windsurf/
.github/skills/
.gemini/

# ─── Editors & operating systems ──────────────────────────────────────────────
*.swp
*.swo
*~
*.sublime-workspace
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.jsonl
logs/

# ─── Temporary files ──────────────────────────────────────────────────────────
tmp/
temp/
scratch/
.cache/

# ─── Agent runtime state ──────────────────────────────────────────────────────
.agents/state/

# ─── State ledger (TRACKED — must not be ignored) ─────────────────────────────
# managed_harnesses.json records every junction/symlink that setup_tools.py
# creates so that --replace-managed-links and --unlink can safely distinguish
# All-skills-managed links from real user directories. It MUST be tracked.
!state/managed_harnesses.json

# ─── Upstream clones & model caches ───────────────────────────────────────────
upstream/
models/cache/*
!models/cache/.gitkeep
